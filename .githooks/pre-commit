#!/usr/bin/env bash
# ==============================================================================
# Seldon Tech Residency - Git Pre-Commit Hook: Mandatory Feature Documentation
# ==============================================================================
# Regra Estrita: É PROIBIDO commitar código (C++, Java, Kotlin, TS, AIDL, BP, RC)
# sem que a documentação correspondente em docs/ ou CHANGELOG.md seja atualizada.
# ==============================================================================

set -e

RED='\033[0;31m'
GREEN='\033[0;32m'
YELLOW='\033[1;33m'
BLUE='\033[0;34m'
NC='\033[0m' # No Color

echo -e "${BLUE}======================================================${NC}"
echo -e "${BLUE}[SELDON QUALITY GATE] Verificando política de documentação...${NC}"
echo -e "${BLUE}======================================================${NC}"

# Obter arquivos em stage para commit
STAGED_FILES=$(git diff --cached --name-only --diff-filter=ACM)

if [ -z "$STAGED_FILES" ]; then
    echo -e "${GREEN}✓ Nenhum arquivo staged. Permitindo commit.${NC}"
    exit 0
fi

# Padrões de código-fonte
CODE_EXTENSIONS="(\.cpp|\.h|\.c|\.java|\.kt|\.tsx|\.ts|\.aidl|\.bp|\.rc|\.py|\.sh)$"

# Padrões de documentação válida
DOCS_PATTERN="(^docs/|CHANGELOG\.md|walkthrough\.md|\.md$)"

HAS_CODE_CHANGES=false
HAS_DOC_CHANGES=false

for file in $STAGED_FILES; do
    if echo "$file" | grep -qE "$CODE_EXTENSIONS"; then
        HAS_CODE_CHANGES=true
    fi
    if echo "$file" | grep -qE "$DOCS_PATTERN"; then
        HAS_DOC_CHANGES=true
    fi
done

# Se houver mudanças de código, a documentação é MANDATÓRIA
if [ "$HAS_CODE_CHANGES" = true ]; then
    if [ "$HAS_DOC_CHANGES" = false ]; then
        echo -e "${RED}[BLOQUEIO] POLÍTICA DE DOCUMENTAÇÃO VIOLADA!${NC}"
        echo -e "${RED}Você está tentando commitar alterações de código-fonte sem atualizar a documentação.${NC}"
        echo -e "${YELLOW}Arquivos de código detectados no stage:${NC}"
        for file in $STAGED_FILES; do
            if echo "$file" | grep -qE "$CODE_EXTENSIONS"; then
                echo -e "  - ${YELLOW}$file${NC}"
            fi
        done
        echo ""
        echo -e "${BLUE}Diretrizes Obrigatórias do Seldon Tech Residency:${NC}"
        echo -e "  1. Crie ou atualize o documento da feature em: ${GREEN}docs/features/FEATURE_XXX_<nome>.md${NC}"
        echo -e "     (Use o template em: docs/features/TEMPLATE.md)"
        echo -e "  2. Ou atualize o arquivo ${GREEN}CHANGELOG.md${NC} com a descrição da mudança."
        echo -e "  3. Adicione a documentação com: ${YELLOW}git add docs/ CHANGELOG.md${NC}"
        echo -e "  4. Execute o commit novamente."
        echo ""
        echo -e "${RED}Commit abortado pelo hook pre-commit.${NC}"
        exit 1
    else
        echo -e "${GREEN}✓ Código e documentação staged simultaneamente. Política atendida!${NC}"
    fi
else
    echo -e "${GREEN}✓ Apenas documentação ou assets staged. Permitindo commit.${NC}"
fi

exit 0
